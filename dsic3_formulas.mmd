%% Dual Scale Inversion Cosmology (DSIC): карта формул.
%% Номера в скобках: номера формул в статье DSIC_3-Azamat_Zaseev (.md и .html).
%% Схема А: как применять формулы, от входных μ₀, H₀, z до величин, которые сравниваются с данными.
%% Схема Б: как формулы выводятся одна из другой и какой у каждой статус.
%% Числа в узлах данных взяты из вывода dsic3_test.py (файл dsic3_test_results.txt).

%%{init: {"flowchart": {"wrappingWidth": 420, "nodeSpacing": 40, "rankSpacing": 48}} }%%
flowchart TB

  subgraph A["А. Как применять формулы"]
    direction TB
    a_mu0(["Фаза сегодня<br/>μ₀"]):::input
    a_z(["Красное смещение<br/>z"]):::input
    a_H0(["Постоянная Хаббла<br/>H₀"]):::input

    a_b0["Масштаб сегодня (8)<br/>b₀ = √(1 − μ₀²) / μ₀²"]:::formula
    a_B["Масштаб в эпоху z (9)<br/>B = b₀ / (1 + z)"]:::formula
    a_K["Темп ядра сегодня (14)<br/>K = (2 − μ₀²) / (1 − μ₀²),  k = H₀ / K"]:::formula
    a_mu["Фаза в эпоху z (10)<br/>s = √(1 + 4B²),  μ² = 2 / (1 + s)"]:::formula
    a_kap["Степень сжатия (23)<br/>κ = μ / √(1 − μ²)"]:::formula
    a_Ec["Темп одного ядра (12)<br/>E_core = (2 − μ²) / [K (1 − μ²)]"]:::formula
    a_dec{"Сжатие включено? (26)<br/>κ #62; κ_h,  κ_h² = 4 + 2√7"}:::decision
    a_late["Ядро как есть<br/>φ = 1"]:::formula
    a_early["Масса связи заперта (25)<br/>φ = G(κ_h) / G(κ)"]:::formula
    a_E["Темп расширения (27)<br/>E² = (1 − Ω_r) φ E_core² + Ω_r (1 + z)⁴"]:::formula
    a_Sig["Внутреннее время (24)<br/>Σ = E_core / E"]:::formula
    a_DH["Радиальное расстояние<br/>D_H = c / (H₀ E)"]:::formula
    a_t["Возраст в эпоху z<br/>t = ∫ dz′ / [(1 + z′) H],  от z до ∞"]:::formula
    a_DM["Поперечное расстояние (18)<br/>D_M = ∫ D_H dz′,  от 0 до z"]:::formula
    a_rs["Звуковой горизонт (32)<br/>r_s = ∫ (c_s / c) D_H dz′,  от z до ∞"]:::formula
    a_dL["Яркость сверхновой<br/>d_L = (1 + z) D_M,  m − M = 5 lg d_L + 25"]:::formula
    a_th["Угол реликта (32)<br/>θ* = r_s(z*) / D_M(z*)"]:::formula

    a_CC[("Хронометры<br/>33 измерения H(z)")]:::data
    a_SN[("Сверхновые, Pantheon+<br/>модуль расстояния")]:::data
    a_BAO[("BAO, DESI DR2<br/>D_M / r_d,  D_H / r_d")]:::data
    a_CMB[("Реликт, Planck 2018<br/>угол θ* и полный спектр")]:::data

    a_mu0 --> a_b0
    a_b0 --> a_B
    a_z --> a_B
    a_mu0 --> a_K
    a_H0 --> a_K
    a_B --> a_mu
    a_mu --> a_kap
    a_mu --> a_Ec
    a_K --> a_Ec
    a_kap --> a_dec
    a_dec -- "нет: поздняя Вселенная" --> a_late
    a_dec -- "да: ранняя Вселенная" --> a_early
    a_late --> a_E
    a_early --> a_E
    a_Ec --> a_E
    a_E --> a_Sig
    a_Ec --> a_Sig
    a_E --> a_DH
    a_E --> a_t
    a_DH --> a_CC
    a_DH --> a_DM
    a_DH --> a_rs
    a_DM --> a_dL
    a_dL --> a_SN
    a_DM --> a_BAO
    a_DH --> a_BAO
    a_rs --> a_BAO
    a_rs --> a_th
    a_DM --> a_th
    a_th --> a_CMB
  end

  subgraph B["Б. Как формулы выводятся"]
    direction TB

    subgraph B1["Поздняя Вселенная: ядро"]
      direction TB
      b_norm["Норма полюсов, P2 (1)<br/>S² + O² = R²"]:::post
      b_flow["Равномерное течение, P3 (2)<br/>|dμ/dt| = k,  μ = |O| / R"]:::post
      b_moduli["Проекция наблюдателя, P4 (6)<br/>P = R√(1 − μ²),  Q = Rμ"]:::post
      b_clock["Линейка и часы, из P4 и P5 (7)<br/>L ∝ μ,  dτ = dt / μ"]:::derived
      b_scale["Наблюдаемый масштаб (8), (9)<br/>b = √(1 − μ²) / μ²,  1 + z = b₀ / b"]:::rule
      b_kin["История расширения (11)<br/>μ = e^(−kτ),  b² = e^(4kτ) − e^(2kτ)"]:::derived
      b_hq["Темп и замедление (12)–(16)<br/>H = k (2 − μ²) / (1 − μ²)<br/>ускорение с μ² = 3 − √5,  q = ½ при μ_h"]:::derived
      b_dist["Расстояния и горизонт (18), (19)<br/>χ = (c / k) b₀ [√(1 − μ₀²) − √(1 − μ_e²)]"]:::derived
      b_late[("Данные поздней Вселенной<br/>сверхновые: Δχ² = −0.1 к ΛCDM<br/>сверхновые + BAO: Δχ² = −5.0")]:::tested
    end

    subgraph B2["Ранняя Вселенная: сжатие"]
      direction TB
      b_limit["Граница ядра (20), (21)<br/>D_M(z*) / D_M(2.33) #60; 1.89 #60; 2.42"]:::derived
      b_p6["Сжатие, P6 (23)<br/>κ = Q / P,  w_obj = min(w_core, 0)"]:::post
      b_sig["Внутреннее время, P6 (24)<br/>dτ = Σ(κ) dt / μ  ⇔  H = H_core / Σ"]:::post
      b_G["Масса связи и точка включения (25), (26)<br/>G(κ) = (2 + κ²)² (1 + κ²)^(3/2) / κ⁶<br/>минимум: κ_h² = 4 + 2√7,  q = ½"]:::derived
      b_E["Одна формула темпа (27), (28)<br/>E² = (1 − Ω_r)(1 + z)³ F(min(z, z_h)) + Ω_r (1 + z)⁴<br/>A_m = (1 − Ω_r) F(z_h)"]:::derived
      b_sigma["Закон Σ (29), (30)<br/>Σ² = [G(κ) / G(κ_h)] / {(1 − Ω_r) [1 + Ω_r (1 + z) / A_m]}"]:::derived
      b_rs["Звуковой горизонт и H₀ (32)<br/>r_s = ∫ c_s dz′ / H,  θ* = r_s(z*) / D_M(z*)"]:::derived
      b_de["Язык тёмной энергии (31), (34)<br/>w_X = −1 + (1/3) d ln X / d ln(1 + z)"]:::derived
      b_joint[("Совместный тест: SN + BAO + θ*<br/>Δχ² = +5.4 к ΛCDM<br/>звуковой горизонт на 1.8 % короче")]:::against
      b_cmb[("Полный спектр реликта, Planck 2018<br/>только реликт: Δχ² = −2.5<br/>с SN и BAO: +8.8<br/>с долей вещества f = 0.944: −7.7")]:::mixed
    end

    b_norm --> b_flow
    b_norm --> b_moduli
    b_moduli --> b_clock
    b_moduli --> b_scale
    b_clock --> b_scale
    b_flow --> b_kin
    b_clock --> b_kin
    b_scale --> b_kin
    b_kin --> b_hq
    b_kin --> b_dist
    b_hq --> b_late
    b_dist --> b_late
    b_dist --> b_limit
    b_hq --> b_limit
    b_moduli --> b_p6
    b_limit --> b_p6
    b_p6 --> b_sig
    b_clock --> b_sig
    b_p6 --> b_G
    b_hq --> b_G
    b_scale --> b_G
    b_G --> b_E
    b_sig --> b_E
    b_E --> b_sigma
    b_sig --> b_sigma
    b_E --> b_rs
    b_E --> b_de
    b_rs --> b_joint
    b_late --> b_joint
    b_E --> b_cmb
    b_joint --> b_cmb
  end

  subgraph L["Статус узлов схемы Б"]
    direction LR
    l_post["постулат"]:::post
    l_rule["правило измерения"]:::rule
    l_der["выведено"]:::derived
    l_ok[("проверено на данных")]:::tested
    l_ag[("против модели")]:::against
    l_mix[("проверено, но не в пользу модели")]:::mixed
  end

